NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set these in the Convex dashboard, not here.
# CLERK_JWT_ISSUER_DOMAIN=  (Clerk Frontend API URL, same value as CLERK_FRONTEND_API_URL)
# Also create a Clerk JWT template named "convex", or activate the Convex integration.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# SITE_URL=http://localhost:3000  (optional OpenRouter app attribution)
# Used only when OPENROUTER_API_KEY is not configured:
# OPENAI_API_KEY=
# EXA_API_KEY=
# APIFY_API_TOKEN=
# APIFY_X_ACTOR=apidojo~tweet-scraper
# APIFY_LINKEDIN_ACTOR=apify~website-content-crawler
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video
# INGEST_SECRET=  (required for POST /api/ingest-post and POST /api/scrape-analyze-url)
